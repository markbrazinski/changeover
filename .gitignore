.env
__pycache__/
*.pyc
.venv/
grafana/data/
prometheus/data/
prometheus/prometheus.yml

# Internal findings/test-run artifacts -- not part of the clean demo repo.
# Note: `docs/*` (not `docs/`) so git still descends into the directory and the negation
# below can re-include a file; an excluded DIRECTORY is never descended into at all.
docs/*
!docs/UI_CONTRACT.md
logs/

# Video is never committed to this repo -- neither supplied source films nor the ffmpeg
# output derived from them. Films are supplied out-of-band (see "Adding a film" in
# README.md) and every derived file is regenerated by running the pipeline scripts.
#
# History: fixtures/source.mp4 was previously committed under a FALSE attribution (it was
# described as Tears of Steel; it was not a film at all). It and its re-encodes were
# removed from HEAD. This blanket rule prevents any video from being committed again.
fixtures/**/*.mp4
fixtures/**/*.webm
fixtures/**/*.mov
fixtures/**/*.mkv

# Caption sidecars ARE committed source -- they are authored text, not derived media.
!fixtures/captions/*.vtt

# OS/editor cruft
.DS_Store
*.swp
