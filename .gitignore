# Internal findings/test-run artifacts -- not part of the clean demo repo.
# Note: `docs/*` (not `docs/`) so git still descends into the directory and the negation
# below can re-include a file; an excluded DIRECTORY is never descended into at all.
docs/*
!docs/UI_CONTRACT.md
logs/

# Generated ffmpeg output and corrupted test debris -- regenerated by running the
# pipeline scripts, not source material. Keep fixtures/source.mp4 (the real input video)
# and fixtures/fixture_[abc].json (static Gate 1 fixtures) as committed source.
fixtures/sign_frozen.mp4
fixtures/sign_baseline.mp4
fixtures/transcoded_*.mp4

