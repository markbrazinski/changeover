# --- Google Cloud / Gemini / ADK ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=

# --- Grafana / Prometheus (local docker-compose stack) ---
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=
PROMETHEUS_URL=http://localhost:9090

# --- Grafana Cloud Mimir remote_write (optional -- only needed if you want the local
# rig to ship metrics to a real Grafana Cloud stack instead of staying fully local).
# This is a separate credential from GRAFANA_SERVICE_ACCOUNT_TOKEN above: it's a
# Grafana.com Access Policy token scoped for metrics push, not the Grafana API.
# Get these from your Grafana Cloud stack -> Connections -> Add new connection ->
# Prometheus -> "From my local Prometheus server" -> "Directly".
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_PROM_REMOTE_WRITE_URL=
GRAFANA_CLOUD_PROM_TOKEN=
